# Copy to .env and edit. Every value has a safe default; Test Mode needs none of the secrets.

APP_NAME=Reparo AI
DATABASE_URL=sqlite:///./reparo.db

# --- Auth / encryption (CHANGE both for any real deployment) ---
AUTH_SECRET=dev-only-change-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Optional integrations ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
RAZORPAY_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Reparo AI <no-reply@reparo.ai>
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Recovery guardrails (enforced in app/recovery/rules.py; the ML layer cannot exceed them) ---
RECOVERY_MAX_RETRIES=3
RECOVERY_MAX_COMMUNICATIONS=3
RECOVERY_COOLDOWN_HOURS=6
RECOVERY_WINDOW_DAYS=7
RECOVERY_MIN_PROBABILITY=0.08

# --- ML layer (app/ml). Set ML_ENABLED=false to run the original rule-based engine exactly. ---
ML_ENABLED=true
ML_BANDIT_ENABLED=true
ML_ANOMALY_ENABLED=true
# Test-Mode ground truth for the sandbox: base | shifted | conservative
#   shifted = drifted dynamics (watch the bandit adapt); conservative = recovery rates calibrated to published industry figures
ML_SANDBOX_WORLD=base
ML_BANDIT_ARMS_HOURS=[0.25,6,12,24,48,72]
ML_BANDIT_PRIOR_STRENGTH=4
ML_FRAUD_MIN_FAILURES=3
ML_OUTAGE_ALPHA=0.0001
ML_MAX_OUTAGE_DEFERRALS=6
ML_LOCAL_UTC_OFFSET_MINUTES=330
